# Pixoo bridge (optional) — Divoom Pixoo 64 is NOT a Pico W.
#
# PIXOO_IP        = Divoom Pixoo LAN IP (HTTP :80 /post)  e.g. 192.168.52.4
# PICO_MERLIN_HOST in .deploy.env was often set to this same IP by mistake —
# that variable is for a Pico W ping check, not for Pixoo push.

PIXOO_IP=192.168.52.4
PIXOO_BRIGHTNESS=50
PIXOO_SCREEN_SECONDS=8
# Graph/dense screens (LOD,TMP,GRP,WLC,TOP,CLI): dwell = SCREEN_SECONDS × multiplier
PIXOO_HEAVY_SCREEN_DWELL=1
PIXOO_HEAVY_SCREEN_MULTIPLIER=2
PIXOO_FRAME_INTERVAL=1.05
# mono = all text one solid color; poly = colored labels (gauges stay colored)
PIXOO_COLOR_MODE=mono
# 1 = scroll long titles/labels that exceed 64px width
PIXOO_TEXT_SCROLL=1
# 1 = blink critical alerts on text/gauges
PIXOO_ALERT_BLINK=1
PIXOO_BLINK_PERIOD=0.55
# short=K/M/G · long=Kb/s|Mb/s|Gb/s
PIXOO_RATE_STYLE=short
# all or SYS,LOD,TMP,GRP,WLC,TOP,CLI,NET,PIE,SRV
PIXOO_SCREENS=all
# PIXOO_METRICS_URL=http://192.168.50.1:8088/metrics.json
