# Pico metrics HTTP exporter + Pixoo bridge (Merlin / Entware)
PICO_METRICS_HOST=0.0.0.0
PICO_METRICS_PORT=8088
# Min seconds between heavy sample() calls
PICO_SAMPLE_MIN_S=3.0
PICO_HISTORY_LEN=64

# Divoom Pixoo 64 (HTTP :80/post) — pushed by pixoo_bridge daemon
PIXOO_IP=192.168.52.4
PIXOO_BRIGHTNESS=50
PIXOO_SCREEN_SECONDS=8
# Graph/dense screens: dwell = SCREEN_SECONDS × multiplier when dwell=1
PIXOO_HEAVY_SCREEN_DWELL=1
PIXOO_HEAVY_SCREEN_MULTIPLIER=2
PIXOO_FRAME_INTERVAL=1.05
PIXOO_COLOR_MODE=mono
PIXOO_TEXT_SCROLL=1
PIXOO_ALERT_BLINK=1
PIXOO_BLINK_PERIOD=0.55
PIXOO_RATE_STYLE=short
# Traffic graphs (GRP WAN + WLC WiFi/Eth): overlay | split
PIXOO_WLC_GRAPH_MODE=overlay
PIXOO_SCREENS=all
PIXOO_METRICS_URL=http://127.0.0.1:8088/metrics.json
