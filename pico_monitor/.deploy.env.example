# Copy to .deploy.env (gitignored) — never store passwords here
#
# Hosts — do not conflate them:
#   PICO_ROUTER_HOST  = Asuswrt-Merlin (SSH + /metrics.json)
#   PICO_MERLIN_HOST  = Pico W LAN IP (ping only) — NOT a Pixoo
#   PIXOO_IP          = Divoom Pixoo 64 (HTTP :80/post) for pixoo_bridge
#
# If 192.168.52.4 answers Pixoo API, put it in PIXOO_IP — pico firmware
# will never light that device.

PICO_ROUTER_HOST=192.168.50.1
PICO_MERLIN_HOST=192.168.52.10
PICO_MERLIN_USER=elphara77
PICO_MERLIN_PATH=/jffs/addons/pico_monitor
PICO_MERLIN_PORT=22
PICO_SSH_AUTH=key
PICO_METRICS_PORT=8088

# Optional Pixoo bridge (see pixoo_bridge/)
PIXOO_IP=192.168.52.4
PIXOO_BRIGHTNESS=50
PIXOO_SCREEN_SECONDS=8
PIXOO_FRAME_INTERVAL=1.05
