# Copy to .deploy.env (gitignored) — never store passwords here
#
# Two different hosts — do not conflate them:
#   PICO_ROUTER_HOST  = Asuswrt-Merlin LAN IP (SSH + /metrics.json)
#   PICO_MERLIN_HOST  = Pico W LAN IP (ping / Wi‑Fi reachability check)
# Firmware uses ROUTER_HOST (= PICO_ROUTER_HOST) to fetch metrics.

PICO_ROUTER_HOST=192.168.50.1
PICO_MERLIN_HOST=192.168.52.4
PICO_MERLIN_USER=elphara77
PICO_MERLIN_PATH=/jffs/addons/pico_monitor
PICO_MERLIN_PORT=22
PICO_SSH_AUTH=key
PICO_METRICS_PORT=8088
