# Copy to .deploy.env (gitignored) — never store passwords here
#
# Hosts — do not conflate them:
#   PICO_ROUTER_HOST  = Asuswrt-Merlin (SSH + /metrics.json + pixoo_bridge)
#   PIXOO_IP          = Divoom Pixoo 64 (HTTP :80/post)
#   PICO_MERLIN_HOST  = optional Pico W OLED (ping only) — NOT the Pixoo

PICO_ROUTER_HOST=192.168.50.1
PIXOO_IP=192.168.52.4
PICO_MERLIN_HOST=
PICO_MERLIN_USER=elphara77
PICO_MERLIN_PATH=/jffs/addons/pico_monitor
PICO_MERLIN_PORT=22
PICO_SSH_AUTH=key
PICO_METRICS_PORT=8088

PIXOO_BRIGHTNESS=50
PIXOO_SCREEN_SECONDS=8
PIXOO_FRAME_INTERVAL=1.05
PIXOO_COLOR_MODE=mono
PIXOO_TEXT_SCROLL=1
PIXOO_ALERT_BLINK=1
PIXOO_BLINK_PERIOD=0.55
