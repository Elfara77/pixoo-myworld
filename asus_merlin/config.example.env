# Copy to config.env and edit. Loaded by run.sh / watchdog.sh / python config loader.

# Divoom Pixoo 64 IP on your LAN (required unless DEMO=1)
PIXOO_IP=192.168.1.50

# Named setup from setups/*.yaml (default = full 5-screen layout)
SETUP=default

BRIGHTNESS=40
SCREEN_SECONDS=8
# Pixoo HTTP rate limit — keep >= 1.0
FRAME_INTERVAL=1.05

# Leave empty to auto-detect via nvram wan0_ifname
WAN_IFACE=
PING_HOST=1.1.1.1

# Bandwidth graph history (seconds)
HISTORY_SECONDS=300
# Min/max stats window (seconds) — default 1 hour
STATS_SECONDS=3600
# Top download clients to show
TOP_CLIENTS=5
# WAN IP marquee speed (higher = faster continuous scroll)
MARQUEE_SPEED=72
# Native disk for pie chart: /jffs (default auto), /opt, or /
DISK_PATH=

# DEMO=1 uses fake metrics (desktop smoke test)
DEMO=0
