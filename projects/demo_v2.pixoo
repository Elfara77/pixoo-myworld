    {
      "id": "system.ram",
      "label": "RAM",
      "plugin": "system",
      "config": {
        "key": "ram"
      },
      "unit": "%",
      "min_value": 0.0,
      "max_value": 100.0
    },
    {
      "id": "system.disk",
      "label": "Disk",
      "plugin": "system",
      "config": {
        "key": "disk"
      },
      "unit": "%",
      "min_value": 0.0,
      "max_value": 100.0
    }
  ],
  "screens": [
    {
      "id": "scr_main",
      "title": "CPU",
      "duration_s": 8.0,
      "background": "#000000",
      "transition": "fade",
      "transition_ms": 400,
      "elements": [
        {
          "id": "t1",
          "type": "text",
          "x": 2,
          "y": 2,
