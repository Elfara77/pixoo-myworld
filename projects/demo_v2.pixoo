          "color": "#3CC8FF",
          "animation": "marquee",
          "speed": 20
        },
        {
          "id": "g1",
          "type": "gauge",
          "x": 2,
          "y": 24,
          "w": 60,
          "h": 8,
          "source": "system.cpu",
          "style": "bar",
          "color": "#28DC64"
        },
        {
          "id": "gr1",
          "type": "graph",
          "x": 2,
          "y": 40,
          "w": 60,
          "h": 20,
