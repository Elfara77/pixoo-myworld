{
  "version": 2,
  "meta": {
    "name": "Studio Demo",
    "author": "",
    "pixoo_ip": "192.168.1.137",
    "brightness": 60,
    "render_mode": "native",
    "refresh_s": 3.0,
    "ui_fps": 20,
    "notes": "Projet exemple Pixoo Studio"
  },
  "runtime": {
    "auto_send": false,
    "send_interval_s": 3.0,
    "max_backoff_s": 60.0,
    "preview_zoom": 8
  },
  "sources": [
    {
      "id": "src_cpu",
      "label": "CPU %",
      "plugin_id": "builtin_psutil",
      "config": {
        "key": "cpu"
      },
      "unit": "%",
      "min_value": 0.0,
      "max_value": 100.0
    },
    {
      "id": "src_disk",
      "label": "Disk %",
      "plugin_id": "builtin_psutil",
      "config": {
        "key": "disk"
      },
      "unit": "%",
      "min_value": 0.0,
      "max_value": 100.0
    },
    {
      "id": "src_rest_demo",
      "label": "REST demo (httpbin)",
      "plugin_id": "rest_jsonpath",
      "config": {
        "url": "https://httpbin.org/json",
        "jsonpath": "$.slideshow.author",
        "timeout_s": 5.0
      },
      "unit": "",
      "min_value": 0.0,
      "max_value": 1.0
    }
  ],
